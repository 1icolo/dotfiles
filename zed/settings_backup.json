// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true
  },
  "git_panel": {
    "dock": "right"
  },
  "relative_line_numbers": "enabled",
  "ui_font_weight": 400.0,
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "colorize_brackets": true,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "pane_split_direction_vertical": "right",
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "terminal": {
    "shell": "system"
  },
  "calls": {
    "mute_on_join": true
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
    // "Cursor Agent CLI": {
    //   "favorite_models": [
    //     "opus-4.5",
    //     "opus-4.5-thinking"
    //   ],
    //   "default_model": "opus-4.5",
    //   "default_mode": "agent",
    //   "type": "custom",
    //   "command": "dx",
    //   "args": ["@blowmage/cursor-agent-acp"],
    //   "env": {},
    // },
  },
  "agent": {
    "dock": "left",
    "model_parameters": []
  },
  "context_servers": {},
  "project_panel": {
    "dock": "right"
  },
  "confirm_quit": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Menlo",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}
