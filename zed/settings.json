{
  "auto_update": false,
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true
  },
  "git_panel": {
    "dock": "right"
  },
  "relative_line_numbers": "enabled",
  "ui_font_weight": 400.0,
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "colorize_brackets": true,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "pane_split_direction_vertical": "right",
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": true
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false
  },
  "terminal": {
    "shell": "system"
  },
  "calls": {
    "mute_on_join": true
  },
  "agent_servers": {
    "Kiro": {
      "command": "kiro-cli",
      "args": ["acp"],
      "type": "custom"
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": ["ollama/qwen3.6"]
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "model_parameters": []
  },
  "context_servers": {},
  "project_panel": {
    "dock": "right"
  },
  "confirm_quit": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "buffer_font_weight": 500.0,
  "buffer_font_family": "Menlo",
  "theme": {
    "mode": "dark",
    "light": "Dawnfox - blurred",
    "dark": "Kanagawa Wave Blur"
  }
}
